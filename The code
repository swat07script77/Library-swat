    -- ============================================================
    -- TRANSPARENCY
    -- ============================================================
    function self:SetBackgroundTransparency(pct)
        pct = math.clamp(pct, 0, 100)
        local t = pct / 100
        self.CurrentBgTransparency = t
        for _, obj in ipairs({main, container, contentFrame, tabContainer, tabPanel}) do
            if obj then obj.BackgroundTransparency = t end
        end
        if titleBar then titleBar.BackgroundTransparency = t * 0.85 end
        if fakeCorner then fakeCorner.BackgroundTransparency = t * 0.85 end
        for _, s in ipairs({
            main:FindFirstChildOfClass("UIStroke"),
            tabContainer:FindFirstChildOfClass("UIStroke"),
        }) do
            if s then s.Transparency = t end
        end
    end

    if saveData["BackgroundTransparency"] then
        self:SetBackgroundTransparency(saveData["BackgroundTransparency"])
    else
        self.CurrentBgTransparency = 0
    end

