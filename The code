            main.Size = UDim2.new(0, 0, 0, 0)
            main.Position = UDim2.new(0.5, 0, 0.5, 0)
            main.BackgroundTransparency = 1
            local bgT = self.CurrentBgTransparency or 0
            local t = TweenService:Create(main, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                BackgroundTransparency = bgT,
                Size = self.Size,
                Position = self.OriginalPosition or UDim2.new(0.5, -self.Size.X.Offset/2, 0.5, -self.Size.Y.Offset/2),
            })
            t:Play()
            t.Completed:Connect(function()
                self:SetBackgroundTransparency((self.CurrentBgTransparency or 0) * 100)
            end)
        end
    end
