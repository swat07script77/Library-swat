    local function doAutoResize()
        local cam = workspace.CurrentCamera
        if not cam then return end
        local vp = cam.ViewportSize
        local w = math.clamp(vp.X * 0.85, 400, vp.X - 20)
        local h = math.clamp(vp.Y * 0.85, 300, vp.Y - 20)
        self.Size = UDim2.new(0, w, 0, h)
        main.Size = self.Size
        main.Position = UDim2.new(0.5, -w/2, 0.5, -h/2)
    end
    local function setAutoResize(v)
        autoResize = v; saveData["AutoResize"] = v; persist()
        if v then
            doAutoResize()
            if not autoResizeConn then
                autoResizeConn = workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
                    if autoResize then doAutoResize() end
                end)
            end
        else
            if autoResizeConn then autoResizeConn:Disconnect(); autoResizeConn = nil end
            self.Size = self.DefaultSize
            main.Size = self.DefaultSize
            main.Position = UDim2.new(0.5, -self.DefaultSize.X.Offset/2, 0.5, -self.DefaultSize.Y.Offset/2)
        end
    end
