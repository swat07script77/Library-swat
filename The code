    local function recolorTree(root, oldAccent, oldDark, oldHover, base, dark, hover)
        if not root then return end
        for _, d in ipairs(root:GetDescendants()) do
            pcall(function()
                if d:IsA("Frame") or d:IsA("TextButton") or d:IsA("TextBox") then
                    local bg = d.BackgroundColor3
                    if bg == oldAccent then d.BackgroundColor3 = base end
                    if bg == oldDark then d.BackgroundColor3 = dark end
                    if bg == oldHover then d.BackgroundColor3 = hover end
                end
                if d:IsA("TextLabel") or d:IsA("TextButton") then
                    if d.TextColor3 == oldAccent then d.TextColor3 = base end
                    if d.TextColor3 == oldDark then d.TextColor3 = dark end
                    if d.TextColor3 == oldHover then d.TextColor3 = hover end
                end
                if d:IsA("ImageLabel") or d:IsA("ImageButton") then
                    if d.ImageColor3 == oldAccent then d.ImageColor3 = base end
                    if d.ImageColor3 == oldDark then d.ImageColor3 = dark end
                end
                local st = d:FindFirstChildOfClass("UIStroke")
                if st then
                    if st.Color == oldAccent then st.Color = base end
                    if st.Color == oldDark then st.Color = dark end
                    if st.Color == oldHover then st.Color = hover end
                end
                local grad = d:FindFirstChildOfClass("UIGradient")
                if grad then
                    local k0 = grad.Color.Keypoints[1].Value
                    local k1 = grad.Color.Keypoints[#grad.Color.Keypoints].Value
                    if k0 == oldDark or k1 == oldAccent then
                        grad.Color = ColorSequence.new(dark, base)
                    end
                end
            end)
        end
    end

    function self:ApplyThemeColor(colorName)
        local base = ColorThemes[colorName]
        local dark = ColorThemesDark[colorName]
        local hover = ColorThemesHover[colorName]
        if not base then return end

        local oldAccent = self.CurrentAccentColor or Theme.Accent
        local oldDark = self.CurrentAccentDark or Theme.AccentDark
        local oldHover = self.CurrentAccentHover or Theme.AccentHover

        self.CurrentAccentColor = base
        self.CurrentAccentDark = dark
        self.CurrentAccentHover = hover

        self:SetTheme({
            Accent = base, AccentDark = dark, AccentHover = hover,
            ElementActive = dark, StrokeLight = base, Success = base,
        })

        for _, el in ipairs(self.Registry.all) do
            if el.Frame and el.Frame.Parent then
                recolorTree(el.Frame, oldAccent, oldDark, oldHover, base, dark, hover)
                if el.Render then pcall(el.Render) end
                if el.RefreshColor then pcall(el.RefreshColor) end
            end
        end

        titleAccentLine.BackgroundColor3 = base
        local tg = titleAccentLine:FindFirstChildOfClass("UIGradient")
        if tg then tg.Color = ColorSequence.new(dark, base) end
        titleAccentDot.BackgroundColor3 = base
        local tds = titleAccentDot:FindFirstChildOfClass("UIStroke")
        if tds then tds.Color = hover end

        for _, t in ipairs(self._tabs) do
            if t.Indicator then t.Indicator.BackgroundColor3 = base end
            if t._selected then t.Button.BackgroundColor3 = dark
            else t.Button.BackgroundColor3 = Theme.Element end
        end

        if settingsPanel then
            recolorTree(settingsPanel, oldAccent, oldDark, oldHover, base, dark, hover)
            local headerLine = settingsPanel:FindFirstChild("HeaderLine")
            if headerLine then
                headerLine.BackgroundColor3 = base
                local g = headerLine:FindFirstChildOfClass("UIGradient")
                if g then g.Color = ColorSequence.new(dark, base) end
            end
            local ps = settingsPanel:FindFirstChildOfClass("UIStroke")
            if ps then ps.Color = dark end
        end

        if miniBar then
            recolorTree(miniBar, oldAccent, oldDark, oldHover, base, dark, hover)
            local mbs = miniBar:FindFirstChildOfClass("UIStroke")
            if mbs then mbs.Color = dark end
            for _, ch in ipairs(miniBar:GetChildren()) do
                if ch:IsA("Frame") then
                    local g = ch:FindFirstChildOfClass("UIGradient")
                    if g then
                        ch.BackgroundColor3 = base
                        g.Color = ColorSequence.new(dark, base)
                    end
                end
            end
            for _, d in ipairs(miniBar:GetDescendants()) do
                if d:IsA("TextLabel") and d.Text == "<>" then
                    d.TextColor3 = base
                end
            end
        end

        if overlayGui then recolorTree(overlayGui, oldAccent, oldDark, oldHover, base, dark, hover) end

        for _, d in ipairs(gui:GetDescendants()) do
            if d.Name == "SwatGlow" then
                d.BackgroundColor3 = base
            end
        end

        if saveData then
            saveData["ThemeColor"] = colorName
            persist()
        end
    end

    -- ============================================================
    -- ELEMENT SCALE
    -- ============================================================
    local elementScale = saveData["ElementScale"] or 1.0
    self.ElementScale = elementScale

    function self:SetElementScale(scale)
        scale = math.clamp(scale, 0.7, 1.5)
        elementScale = scale
        self.ElementScale = scale
        saveData["ElementScale"] = scale
        persist()
        for _, el in ipairs(self.Registry.all) do
            if el.Frame and el.Frame.Parent then
                pcall(function()
                    local t = el:GetType()
                    if t == "buttons" or t == "toggles" or t == "textboxes"
                       or t == "keybinds" or t == "fontPickers"
                       or t == "themePresets" or t == "colorPickers" then
                        el.Frame.Size = UDim2.new(1, 0, 0, math.floor((isTouch and 44 or 40) * scale))
                    elseif t == "sliders" then
                        el.Frame.Size = UDim2.new(1, 0, 0, math.floor((isTouch and 56 or 50) * scale))
                    elseif t == "labels" then
                        el.Frame.Size = UDim2.new(1, 0, 0, math.floor(20 * scale))
                    end
                end)
            end
        end
    end

    -- ============================================================
    -- FONT SCALE
    -- ============================================================
    local fontScale = saveData["FontScale"] or 1.0
    self.FontScale = fontScale

    local function snapshotFonts()
        local function scan(obj)
            if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
                if obj:GetAttribute("BaseTextSize") == nil then
                    obj:SetAttribute("BaseTextSize", obj.TextSize)
                end
            end
            for _, c in ipairs(obj:GetChildren()) do scan(c) end
        end
        if main then scan(main) end
        if gui then scan(gui) end
        if overlayGui then scan(overlayGui) end
    end

    function self:SetFontScale(scale)
        scale = math.clamp(scale, 0.7, 1.5)
        fontScale = scale
        self.FontScale = scale
        saveData["FontScale"] = scale
        persist()
        snapshotFonts()
        local function applyFont(obj)
            if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
                local base = obj:GetAttribute("BaseTextSize")
                if base then
                    obj.TextSize = math.max(6, math.floor(base * scale + 0.5))
                end
            end
            for _, c in ipairs(obj:GetChildren()) do applyFont(c) end
        end
        if main then applyFont(main) end
        if gui then applyFont(gui) end
        if overlayGui then applyFont(overlayGui) end
    end

    -- ============================================================
    -- FONT FAMILY
    -- ============================================================
    local originalFontsMap = {}

    local function saveOriginalFonts()
        local function storeRecursive(obj)
            if (obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox")) then
                if not originalFontsMap[obj] then
                    originalFontsMap[obj] = obj.Font
                end
            end
            for _, child in pairs(obj:GetChildren()) do
                storeRecursive(child)
            end
        end
        if main then storeRecursive(main) end
        if gui then storeRecursive(gui) end
        if overlayGui then storeRecursive(overlayGui) end
    end

    local function applyFontToAll(fontEnum)
        saveOriginalFonts()
        local function applyFontRecursive(obj)
            if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
                pcall(function() obj.Font = fontEnum end)
            end
            for _, child in pairs(obj:GetChildren()) do
                applyFontRecursive(child)
            end
        end
        if main then applyFontRecursive(main) end
        if gui then applyFontRecursive(gui) end
        if overlayGui then applyFontRecursive(overlayGui) end

        self.SelectedFont = fontEnum.Name
        saveData["SelectedFont"] = fontEnum.Name
        persist()
    end

    local function restoreOriginalFonts()
        for obj, font in pairs(originalFontsMap) do
            if obj and obj.Parent then
                pcall(function() obj.Font = font end)
            end
        end
        self.SelectedFont = nil
        saveData["SelectedFont"] = nil
        persist()
    end

    if saveData["SelectedFont"] then
        self.SelectedFont = saveData["SelectedFont"]
    end

