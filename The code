    local resizeActive = saveData["Resize"] or false
    local MIN_R = Vector2.new(300, 300)
    local MAX_R = Vector2.new(900, 700)
    local resizeHandle, resizeConns = nil, {}
    local function destroyResize()
        for _, c in ipairs(resizeConns) do c:Disconnect() end
        resizeConns = {}
        if resizeHandle then resizeHandle:Destroy(); resizeHandle = nil end
    end
    local function buildResize()
        destroyResize()
        resizeHandle = Create("ImageButton", {
            Name = "SwatResizeHandle",
            Size = UDim2.new(0, 20, 0, 20),
            Position = UDim2.new(1, -22, 1, -22),
            BackgroundTransparency = 1,
            Image = LibraryIcons["mouse-pointer-click"] and "rbxassetid://" .. LibraryIcons["mouse-pointer-click"] or "",
            ImageColor3 = Theme.TextMuted,
            ZIndex = 100,
        })
        resizeHandle.Parent = main
        local dragging, start, startSize = false, nil, nil
        table.insert(resizeConns, resizeHandle.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true; start = input.Position; startSize = main.AbsoluteSize
            end
        end))
        table.insert(resizeConns, UserInputService.InputChanged:Connect(function(input)
            if dragging and start and startSize and (input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch) then
                local d = input.Position - start
                local w = math.clamp(startSize.X + d.X, MIN_R.X, MAX_R.X)
                local h = math.clamp(startSize.Y + d.Y, MIN_R.Y, MAX_R.Y)
                self.Size = UDim2.new(0, w, 0, h)
                main.Size = self.Size
            end
        end))
        table.insert(resizeConns, UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
        end))
    end
    local function setResize(v)
