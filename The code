                NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0)
            }
        }).Parent = valLayer

        local svIndicator = Create("Frame", {
            Size = UDim2.new(0, 10, 0, 10), AnchorPoint = Vector2.new(0.5, 0.5),
            BackgroundColor3 = Color3.new(1,1,1), BorderSizePixel = 0, ZIndex = 7,
        }, { Corner(99), Stroke(Color3.new(0,0,0), 1.5) })
        svIndicator.Parent = svContainer

        local svButton = Create("TextButton", { Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 8 })
        svButton.Parent = svContainer

        local hueBar = Create("Frame", {
            Size = UDim2.new(0, HUE_W, 0, SV_SIZE), Position = UDim2.new(0, 12 + SV_SIZE + 12, 0, 12),
            BorderSizePixel = 0, ZIndex = 5,
        }, { Corner(6) })
        hueBar.Parent = contentHolder
        Create("UIGradient", {
            Rotation = 90,
            Color = ColorSequence.new{
                ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
                ColorSequenceKeypoint.new(0.16, Color3.fromRGB(255, 255, 0)),
                ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0, 255, 0)),
                ColorSequenceKeypoint.new(0.5, Color3.fromRGB(0, 255, 255)),
                ColorSequenceKeypoint.new(0.66, Color3.fromRGB(0, 0, 255)),
                ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255, 0, 255)),
                ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 0)),
            }
        }).Parent = hueBar

        local hueIndicator = Create("Frame", {
            Size = UDim2.new(1, 8, 0, 6), AnchorPoint = Vector2.new(0, 0.5),
            BackgroundColor3 = Color3.new(1,1,1), BorderSizePixel = 0, ZIndex = 7,
        }, { Corner(99) })
        hueIndicator.Parent = hueBar

        local hueButton = Create("TextButton", { Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 8 })
        hueButton.Parent = hueBar

        local preview = Create("Frame", {
            Size = UDim2.new(0, PREVIEW_SIZE, 0, PREVIEW_SIZE),
            Position = UDim2.new(0, 12 + SV_SIZE + 12 + HUE_W + 12, 0, 12),
            BackgroundColor3 = defaultColor, BorderSizePixel = 0, ZIndex = 5,
        }, { Corner(6), Stroke(Theme.StrokeLight, 1) })
        preview.Parent = contentHolder

        local currentColor = defaultColor
        local currentHue, currentSat, currentVal = currentColor:ToHSV()

        local function updateUI()
            svBase.BackgroundColor3 = Color3.fromHSV(currentHue, 1, 1)
            preview.BackgroundColor3 = Color3.fromHSV(currentHue, currentSat, currentVal)
            svIndicator.Position = UDim2.new(currentSat, 0, 1 - currentVal, 0)
            hueIndicator.Position = UDim2.new(0, -4, currentHue, 0)
        end
        local function applyColor(c, fireCallback)
            currentColor = c
            swatchBtn.BackgroundColor3 = c
            currentHue, currentSat, currentVal = c:ToHSV()
            updateUI()
            setStatus(Status.ON)
            if themeKey then window:SetTheme({ [themeKey] = c }) end
            if fireCallback and callback then task.spawn(callback, c) end
        end

        local function handleInput(input, frameObj, cb)
            local size = frameObj.AbsoluteSize
            local pos = frameObj.AbsolutePosition
            local x = math.clamp((input.Position.X - pos.X) / size.X, 0, 1)
            local y = math.clamp((input.Position.Y - pos.Y) / size.Y, 0, 1)
            cb(x, y)
        end

        local draggingSV, draggingHue = false, false
        svButton.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                draggingSV = true
                handleInput(input, svContainer, function(x, y)
                    currentSat, currentVal = x, 1 - y
                    applyColor(Color3.fromHSV(currentHue, currentSat, currentVal), true)
                end)
            end
        end)
        hueButton.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                draggingHue = true
                handleInput(input, hueBar, function(_, y)
                    currentHue = y
                    applyColor(Color3.fromHSV(currentHue, currentSat, currentVal), true)
                end)
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if input.UserInputType ~= Enum.UserInputType.MouseMovement
                and input.UserInputType ~= Enum.UserInputType.Touch then return end
            if draggingSV then
                handleInput(input, svContainer, function(x, y)
                    currentSat, currentVal = x, 1 - y
                    applyColor(Color3.fromHSV(currentHue, currentSat, currentVal), true)
                end)
            elseif draggingHue then
                handleInput(input, hueBar, function(_, y)
                    currentHue = y
                    applyColor(Color3.fromHSV(currentHue, currentSat, currentVal), true)
                end)
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                draggingSV = false; draggingHue = false
            end
        end)

