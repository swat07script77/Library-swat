                Position = self.OriginalPosition or UDim2.new(0.5, -self.Size.X.Offset/2, 0.5, -self.Size.Y.Offset/2),
            })
            t:Play()
            t.Completed:Connect(function()
                self:SetBackgroundTransparency((self.CurrentBgTransparency or 0) * 100)
