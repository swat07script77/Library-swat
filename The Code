                or input.UserInputType == Enum.UserInputType.Touch) then
                local d = input.Position - start
                main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X,
                                          startPos.Y.Scale, startPos.Y.Offset + d.Y)
            end
        end))
        table.insert(dragBarConns, UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
                Tween(dragBar, 0.15, { BackgroundTransparency = 0.95 })
            end
        end))
    end
    local function setDragBar(v)
        dragBarActive = v; saveData["DragBar"] = v; persist()
        if v then buildDragBar() else destroyDragBar() end
    end
    local dragBarToggle = panelToggle("Bottom Drag Bar", dragBarActive, setDragBar)
    if dragBarActive then task.delay(0.4, function() setDragBar(true) end) end

    local colorDropdown = panelDropdown("Theme Color", ColorList, saveData["ThemeColor"] or "Blue", function(name)
        self:ApplyThemeColor(name)
    end)

    if saveData["ThemeColor"] and ColorThemes[saveData["ThemeColor"]] then
        task.defer(function() self:ApplyThemeColor(saveData["ThemeColor"]) end)
    end

    -- ============================================================
    -- RESET BUTTON
    -- ============================================================
    panelButton(" RESET ALL SETTINGS", Theme.Error, function()
        if isfile and delfile and isfile(SAVE_FILE) then pcall(delfile, SAVE_FILE) end
        saveData = {}

        for k in pairs(Theme) do Theme[k] = nil end
        for k, v in pairs(DefaultThemeCopy) do Theme[k] = v end
        self.CurrentAccentColor = Theme.Accent
        self.CurrentAccentDark = Theme.AccentDark
        self.CurrentAccentHover = Theme.AccentHover

        for _, ref in ipairs(panelRefs) do
            if ref.api and ref.api.SetValue then
                pcall(function() ref.api.SetValue(ref.default) end)
            end
        end

        self.ToggleSpeed = 0.2
        self.ToggleKey = "K"
        self.SelectedFont = nil
        self.CurrentBgTransparency = 0
        restoreOriginalFonts()

        self:SetBackgroundTransparency(0)
        self:SetElementScale(1.0)
        self:SetFontScale(1.0)

        notifyEnabled = true
        self.Notify = _realNotify
        if autoResize then setAutoResize(false) end
        if resizeActive then setResize(false) end
        if dragBarActive then setDragBar(false) end

        self:ApplyThemeColor("Blue")
        persist()

        self:Notify({ Title = "Reset", Description = "Tudo restaurado!", Duration = 2, Type = "success" })
    end)

    task.defer(snapshotFonts)
    if saveData["FontScale"] then
        task.defer(function() self:SetFontScale(saveData["FontScale"]) end)
    end

    if saveData["SelectedFont"] then
        task.defer(function()
            for _, fontEnum in ipairs(Enum.Font:GetEnumItems()) do
                if fontEnum.Name == saveData["SelectedFont"] then
                    applyFontToAll(fontEnum)
                    break
                end
            end
        end)
    end

    for _, d in ipairs(gui:GetDescendants()) do
        if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
            pcall(function() d.TextScaled = false end)
        end
    end

    -- ============================================================
    -- MÉTODOS PÚBLICOS
    -- ============================================================
    function self:SetTheme(patch)
        for k, v in pairs(patch) do Theme[k] = v end
        for _, applyFn in ipairs(self._themeListeners) do pcall(applyFn, Theme) end
        Tween(main, 0.25, { BackgroundColor3 = Theme.Background })
        Tween(tabPanel, 0.25, { BackgroundColor3 = Theme.BackgroundAlt })
        Tween(tabContainer, 0.25, { BackgroundColor3 = Theme.BackgroundAlt })
        Tween(titleBar, 0.25, { BackgroundColor3 = Theme.BackgroundAlt })
    end

    function self:GetTheme() return Theme end
    function self:GetColor(key) return Theme[key] end
    function self:RegisterThemeListener(fn) table.insert(self._themeListeners, fn) end

    function self:ResetTheme()
        for k in pairs(Theme) do Theme[k] = nil end
        for k, v in pairs(DefaultThemeCopy) do Theme[k] = v end
        for _, applyFn in ipairs(self._themeListeners) do pcall(applyFn, Theme) end
        Tween(main, 0.25, { BackgroundColor3 = Theme.Background })
        Tween(tabPanel, 0.25, { BackgroundColor3 = Theme.BackgroundAlt })
        Tween(tabContainer, 0.25, { BackgroundColor3 = Theme.BackgroundAlt })
        Tween(titleBar, 0.25, { BackgroundColor3 = Theme.BackgroundAlt })
    end

    function self:RegisterType(type, el)
        local list = self.Registry[type]
        if list then table.insert(list, el) end
        table.insert(self.Registry.all, el)
        return el
    end

    function self:ForEach(kind, fn)
        local list = self.Registry[kind] or self.Registry.all
        for _, el in ipairs(list) do pcall(fn, el) end
    end

    function self:SetAllColor(color) self:ForEach("all", function(el) el:SetBackground(color) end) end
    function self:SetAllFont(font) self:SetTheme({ ElementFont = font, TitleFont = font }) end
    function self:SetAllTitleColor(color) self:ForEach("all", function(el) el:SetTextColor(color) end) end
    function self:SetAllCorner(r) self:ForEach("all", function(el) el:SetCorner(r) end) end
    function self:SetAllStroke(color, t) self:ForEach("all", function(el) el:SetStroke(color, t) end) end
    function self:SetAllVisible(v) self:ForEach("all", function(el) el:SetVisible(v) end) end
    function self:PulseAll(n, d) self:ForEach("all", function(el) el:Pulse(n, d) end) end
    function self:FlashAllColors(c, d) self:ForEach("all", function(el) el:FlashColor(c, nil, d) end) end
    function self:GetElements(kind) return self.Registry[kind] or self.Registry.all end
    function self:CountElements()
        local c = {}
        for k, v in pairs(self.Registry) do if type(v) == "table" then c[k] = #v end end
        return c
    end

    function self:CreateTab(name)
        local tabButton = Create("TextButton", {
            Size = UDim2.new(1, 0, 0, isTouch and 36 or 32),
            BackgroundColor3 = Theme.Element, BorderSizePixel = 0,
            Text = name, TextColor3 = Theme.TextDim,
            Font = Theme.ElementFont, TextSize = 11, AutoButtonColor = false,
        }, { Corner(Theme.CornerRadius), Stroke(Theme.Stroke, 1) })
        tabButton.Parent = tabPanel

        local indicator = Create("Frame", {
            Size = UDim2.new(0, 3, 0, 16), Position = UDim2.new(0, -1, 0.5, -8),
            BackgroundColor3 = Theme.Accent, BorderSizePixel = 0, BackgroundTransparency = 1,
        }, { Corner(2) })
        indicator.Parent = tabButton

        local tabContent = Create("Frame", {
            Size = UDim2.new(1, 0, 0, 0), BackgroundTransparency = 1,
            Visible = false, AutomaticSize = Enum.AutomaticSize.Y,
        })
        tabContent.Parent = tabContainer

        Create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 7) }).Parent = tabContent
        Create("UIPadding", {
            PaddingTop = UDim.new(0, 9), PaddingBottom = UDim.new(0, 9),
            PaddingLeft = UDim.new(0, 9), PaddingRight = UDim.new(0, 9),
        }).Parent = tabContent

        local tab = {
            Button = tabButton, Content = tabContent, Window = self,
            Indicator = indicator, _selected = false, Name = name,
        }

        tabButton.MouseEnter:Connect(function()
            if not tab._selected then
                Tween(tabButton, 0.15, { BackgroundColor3 = Theme.ElementHover, TextColor3 = Theme.Text })
            end
        end)
        tabButton.MouseLeave:Connect(function()
            if not tab._selected then
                Tween(tabButton, 0.15, { BackgroundColor3 = Theme.Element, TextColor3 = Theme.TextDim })
            end
        end)
        tabButton.MouseButton1Click:Connect(function()
            for _, t in ipairs(self._tabs) do
                t._selected = false
                t.Content.Visible = false
                Tween(t.Button, 0.15, { BackgroundColor3 = Theme.Element, TextColor3 = Theme.TextDim })
                if t.Indicator then Tween(t.Indicator, 0.15, { BackgroundTransparency = 1 }) end
            end
            tab._selected = true
            self.CurrentTab = tab
            tabContent.Visible = true
            Tween(tabButton, 0.15, {
                BackgroundColor3 = self.CurrentAccentDark or Theme.ElementActive,
                TextColor3 = Theme.Text,
            })
            Tween(indicator, 0.15, { BackgroundTransparency = 0 })
        end)

        table.insert(self._tabs, tab)
        if #self._tabs == 1 then
            tab._selected = true
            self.CurrentTab = tab
            tabContent.Visible = true
            tabButton.BackgroundColor3 = self.CurrentAccentDark or Theme.ElementActive
            tabButton.TextColor3 = Theme.Text
            indicator.BackgroundTransparency = 0
        end

        self:RegisterThemeListener(function()
            Tween(tabButton, 0.2, {
                BackgroundColor3 = tab._selected and (self.CurrentAccentDark or Theme.ElementActive) or Theme.Element,
                TextColor3 = tab._selected and Theme.Text or Theme.TextDim,
                Font = Theme.ElementFont,
            })
            Tween(indicator, 0.2, { BackgroundColor3 = self.CurrentAccentColor or Theme.Accent })
        end)

        tab.Select = function() tabButton.MouseButton1Click:Fire() end

        return self:_ExtendTab(tab)
    end

    function self:Notify(config)
        local cfg = type(config) == "table" and config or { Title = "Notice", Description = tostring(config) }
        local duration = cfg.Duration or 3

        local kind = cfg.Type or "info"
        local color = self.CurrentAccentColor or Theme.Accent
        if kind == "success" then color = self.CurrentAccentColor or Theme.Success end
        if kind == "warning" then color = Theme.Warning end
        if kind == "error" then color = Theme.Error end

        local holder = gui:FindFirstChild("Notifications")
        if not holder then
            holder = Create("Frame", {
                Name = "Notifications",
                Size = UDim2.new(0, isTouch and 250 or 280, 1, 0),
                Position = UDim2.new(1, isTouch and -260 or -290, 0, 80),
                BackgroundTransparency = 1,
            })
            holder.Parent = gui
            Create("UIListLayout", {
                SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 7),
                VerticalAlignment = Enum.VerticalAlignment.Top,
            }).Parent = holder
        end

        local notif = Create("Frame", {
            Size = UDim2.new(1, 0, 0, 60),
            BackgroundColor3 = Theme.Panel, BackgroundTransparency = 1,
            BorderSizePixel = 0, ClipsDescendants = true,
        }, { Corner(10), Stroke(color, 1) })
        notif.Parent = holder
        notif.Position = UDim2.new(0, 20, 0, 0)

        local bar = Create("Frame", {
            Size = UDim2.new(0, 4, 1, 0), BackgroundColor3 = color, BorderSizePixel = 0,
        }, { Gradient(color, color:Lerp(Theme.Background, 0.4), 90) })
        bar.Parent = notif

        local titleLbl = Create("TextLabel", {
            Size = UDim2.new(1, -40, 0, 18), Position = UDim2.new(0, 14, 0, 8),
            BackgroundTransparency = 1, Text = cfg.Title or "Notice",
            TextColor3 = Theme.Text, Font = Theme.TitleFont, TextSize = 11,
            TextXAlignment = Enum.TextXAlignment.Left, TextTransparency = 1,
        })
        titleLbl.Parent = notif

        local descLbl = Create("TextLabel", {
            Size = UDim2.new(1, -28, 0, 28), Position = UDim2.new(0, 14, 0, 26),
            BackgroundTransparency = 1, Text = cfg.Description or "",
            TextColor3 = Theme.TextDim, Font = Theme.ElementFont, TextSize = 10,
            TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true, TextTransparency = 1,
        })
        descLbl.Parent = notif

        TweenService:Create(notif, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Position = UDim2.new(0, 0, 0, 0), BackgroundTransparency = 0,
        }):Play()
        Tween(titleLbl, 0.3, { TextTransparency = 0 })
        Tween(descLbl, 0.3, { TextTransparency = 0 })

        task.delay(duration, function()
            if not (notif and notif.Parent) then return end
            local exitTween = TweenService:Create(notif, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                Position = UDim2.new(0, 60, 0, 0), BackgroundTransparency = 1,
            })
            exitTween:Play()
            Tween(titleLbl, 0.3, { TextTransparency = 1 })
            Tween(descLbl, 0.3, { TextTransparency = 1 })
            Tween(bar, 0.3, { BackgroundTransparency = 1 })
            exitTween.Completed:Connect(function() if notif then notif:Destroy() end end)
        end)

        return notif
    end

    return self
end

-- ============================================================
-- TAB ELEMENTS
-- ============================================================
function SwatUI:_ExtendTab(tab)
    local window = tab.Window
    local content = tab.Content
    local isTouch = window.IsTouch
    local order = 0
    local function nextOrder() order = order + 1; return order end

    function tab:CreateSection(title)
        local sec = Create("Frame", {
            Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = Theme.Panel,
            BorderSizePixel = 0, LayoutOrder = nextOrder(), ClipsDescendants = true,
        }, { Corner(Theme.CornerRadius) })
        sec.Parent = content

        local inner = Create("Frame", {
            Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = Theme.Panel, BorderSizePixel = 0,
        }, { Corner(Theme.CornerRadius), Gradient(Theme.Panel, Theme.Element, 0), Stroke(Theme.StrokeLight, 1) })
        inner.Parent = sec

        local accentBar = Create("Frame", {
            Size = UDim2.new(0, 3, 0.6, 0), Position = UDim2.new(0, 0, 0.2, 0),
            BackgroundColor3 = Theme.Accent, BorderSizePixel = 0,
        }, { Corner(2) })
        accentBar.Parent = sec

        local titleLbl = Create("TextLabel", {
            Size = UDim2.new(1, -24, 1, 0), Position = UDim2.new(0, 14, 0, 0),
            BackgroundTransparency = 1, Text = title,
            TextColor3 = Theme.Text, Font = Theme.TitleFont, TextSize = 10,
            TextXAlignment = Enum.TextXAlignment.Left,
        })
        titleLbl.Parent = sec

        window:RegisterThemeListener(function()
            Tween(sec, 0.2, { BackgroundColor3 = Theme.Panel })
            Tween(inner, 0.2, { BackgroundColor3 = Theme.Panel })
            accentBar.BackgroundColor3 = window.CurrentAccentColor or Theme.Accent
            Tween(titleLbl, 0.2, { TextColor3 = Theme.Text })
        end)

        local el = NewElement("sections", sec)
        el.SetTitle = function(_, t) titleLbl.Text = t end
        el.SetFont = function(_, f) titleLbl.Font = f end
        el.SetTextColor = function(_, c) titleLbl.TextColor3 = c end
        window:RegisterType("sections", el)
        return sec
    end

    function tab:CreateButton(cfg)
        cfg = cfg or {}
        local frame = Create("Frame", {
            Size = UDim2.new(1, 0, 0, isTouch and 44 or 40),
            BackgroundColor3 = Theme.Element, BorderSizePixel = 0,
            LayoutOrder = nextOrder(), ClipsDescendants = true,
        }, { Corner(Theme.CornerRadius), Stroke(Theme.Stroke, 1) })
        frame.Parent = content

        local statusBar, setStatus = MakeStatusBar(frame, Status.ACTIVE)

        local icon = Create("ImageLabel", {
            Size = UDim2.new(0, 16, 0, 16), Position = UDim2.new(0, 24, 0.5, -8),
            BackgroundTransparency = 1, Image = ICONS.CLICK, ImageColor3 = Theme.Accent, ZIndex = 4,
        })
        icon.Parent = frame

        local lbl = Create("TextLabel", {
            Size = UDim2.new(1, -80, 1, 0), Position = UDim2.new(0, 48, 0, 0),
            BackgroundTransparency = 1, Text = cfg.Title or "Button",
            TextColor3 = Theme.Text, Font = Theme.ElementFont, TextSize = 11,
            TextXAlignment = Enum.TextXAlignment.Left,
        })
        lbl.Parent = frame

        local arrow = Create("TextLabel", {
            Size = UDim2.new(0, 20, 1, 0), Position = UDim2.new(1, -26, 0, 0),
            BackgroundTransparency = 1, Text = "",
            TextColor3 = Theme.TextMuted, Font = Enum.Font.GothamBold, TextSize = 15,
        })
        arrow.Parent = frame

        local btn = Create("TextButton", { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
            Text = "", AutoButtonColor = false })
        btn.Parent = frame

        AddButtonGlow(btn, window.CurrentAccentColor or Theme.Accent)

        btn.MouseEnter:Connect(function()
            Tween(frame, 0.15, { BackgroundColor3 = Theme.ElementHover })
            Tween(arrow, 0.15, { Position = UDim2.new(1, -20, 0, 0), TextColor3 = window.CurrentAccentColor or Theme.Accent })
            Tween(icon, 0.15, { ImageColor3 = window.CurrentAccentHover or Theme.AccentHover })
        end)
        btn.MouseLeave:Connect(function()
            Tween(frame, 0.15, { BackgroundColor3 = Theme.Element })
            Tween(arrow, 0.15, { Position = UDim2.new(1, -26, 0, 0), TextColor3 = Theme.TextMuted })
            Tween(icon, 0.15, { ImageColor3 = window.CurrentAccentColor or Theme.Accent })
        end)
        btn.MouseButton1Click:Connect(function()
            local s = frame.Size
            Tween(frame, 0.08, { Size = UDim2.new(1, -4, 0, s.Y.Offset - 2) })
            task.delay(0.1, function() Tween(frame, 0.08, { Size = s }) end)
            setStatus(Status.ON)
            task.delay(0.6, function() setStatus(Status.ACTIVE) end)
            if cfg.Callback then task.spawn(cfg.Callback) end
        end)

        window:RegisterThemeListener(function()
            Tween(frame, 0.2, { BackgroundColor3 = Theme.Element })
            Tween(lbl, 0.2, { TextColor3 = Theme.Text })
            icon.ImageColor3 = window.CurrentAccentColor or Theme.Accent
        end)

        local el = NewElement("buttons", frame)
        el.SetTitle     = function(_, t) lbl.Text = t end
        el.SetFont      = function(_, f) lbl.Font = f end
        el.SetTextColor = function(_, c) lbl.TextColor3 = c end
        el.SetIcon      = function(_, id) icon.Image = id end
        el.SetIconColor = function(_, c) icon.ImageColor3 = c end
        el.SetIconSize  = function(_, px)
            icon.Size = UDim2.new(0, px, 0, px)
            icon.Position = UDim2.new(0, 24, 0.5, -px/2)
        end
        el.SetIconVisible = function(_, v) icon.Visible = v end
        el.Icon = icon
        window:RegisterType("buttons", el)
        return el
    end

    function tab:CreateLabel(text)
        local holder = Create("Frame", {
            Size = UDim2.new(1, 0, 0, 20), BackgroundTransparency = 1, LayoutOrder = nextOrder(),
