    -- ============================================================
    function tab:CreateDropdown(cfg)
        cfg = cfg or {}
        local currentOptions = {}
        for i, v in ipairs(cfg.Options or {}) do currentOptions[i] = v end
        local selected = cfg.Default or currentOptions[1] or "Select"
        local callback = cfg.Callback
        local BASE_HEIGHT = isTouch and 44 or 40
        local MAX_HEIGHT = BASE_HEIGHT * 4

        local frame = Create("Frame", {
            Size = UDim2.new(1, 0, 0, BASE_HEIGHT), BackgroundColor3 = Theme.Element,
            BorderSizePixel = 0, LayoutOrder = nextOrder(), ClipsDescendants = true,
        }, { Corner(Theme.CornerRadius), Stroke(Theme.Stroke, 1) })
        frame.Parent = content

        local inner = Create("Frame", {
            Size = UDim2.new(1, 0, 0, BASE_HEIGHT), BackgroundColor3 = Theme.Element, BorderSizePixel = 0,
        }, { Corner(Theme.CornerRadius) })
        inner.Parent = frame

        local statusBar, setStatus = MakeStatusBar(inner, Status.OFF)

        local header = Create("Frame", {
            Size = UDim2.new(1, 0, 0, BASE_HEIGHT), BackgroundColor3 = Theme.Element,
            BorderSizePixel = 0, ZIndex = 5,
        }, { Corner(Theme.CornerRadius) })
        header.Parent = inner

        local lbl = Create("TextLabel", {
            Size = UDim2.new(1, -190, 1, 0), Position = UDim2.new(0, 24, 0, 0),
            BackgroundTransparency = 1, Text = cfg.Title or "Dropdown",
            TextColor3 = Theme.Text, Font = Theme.ElementFont, TextSize = 11,
            TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
        })
        lbl.Parent = header

        local mainBtn = Create("TextButton", {
            Size = UDim2.new(0, 140, 0, 28), Position = UDim2.new(1, -152, 0.5, -14),
            BackgroundColor3 = Theme.Panel, BorderSizePixel = 0, Text = "", AutoButtonColor = false,
        }, { Corner(6), Stroke(Theme.StrokeLight, 1) })
        mainBtn.Parent = header

        local btnText = Create("TextLabel", {
            Size = UDim2.new(1, -40, 1, 0), Position = UDim2.new(0, 10, 0, 0),
            BackgroundTransparency = 1, Text = selected,
            TextColor3 = Theme.Text, Font = Theme.ElementFont, TextSize = 10,
            TextTruncate = Enum.TextTruncate.AtEnd, TextXAlignment = Enum.TextXAlignment.Left,
        })
        btnText.Parent = mainBtn

        local iconLabel = Create("ImageLabel", {
            Size = UDim2.new(0, 16, 0, 16), Position = UDim2.new(1, -22, 0.5, -8),
            BackgroundTransparency = 1, Image = ICONS.CLICK, ImageColor3 = Theme.Accent,
        })
        iconLabel.Parent = mainBtn

        local closeIcon = Create("ImageLabel", {
            Size = UDim2.new(0, 16, 0, 16), Position = UDim2.new(1, -22, 0.5, -8),
            BackgroundTransparency = 1, Image = ICONS.CLOSE, ImageColor3 = Theme.Accent, Visible = false,
        })
        closeIcon.Parent = mainBtn

        local listHolder = Create("Frame", {
            Size = UDim2.new(1, -12, 0, 0), Position = UDim2.new(0, 6, 0, BASE_HEIGHT),
            BackgroundTransparency = 1, ClipsDescendants = true, ZIndex = 3,
        })
        listHolder.Parent = inner

        local listScroll = Create("ScrollingFrame", {
            Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, BorderSizePixel = 0,
            ScrollBarThickness = isTouch and 6 or 4, ScrollBarImageColor3 = Theme.AccentDark,
            AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(0, 0, 0, 0),
            ScrollingDirection = Enum.ScrollingDirection.Y,
            ElasticBehavior = Enum.ElasticBehavior.Never, ZIndex = 4,
        })
        listScroll.Parent = listHolder

        Create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 3) }).Parent = listScroll

        local isOpen = false
        local optionButtons = {}
        local openList, closeList, rebuildList

        local function getWantedListHeight()
            local contentSize = listScroll.UIListLayout.AbsoluteContentSize.Y + 8
            local listMax = MAX_HEIGHT - BASE_HEIGHT
            return math.min(contentSize, listMax)
        end

        rebuildList = function()
            for _, b in ipairs(optionButtons) do b:Destroy() end
            optionButtons = {}
            for i, opt in ipairs(currentOptions) do
                local isSelected = (opt == selected)
                local item = Create("TextButton", {
                    Size = UDim2.new(1, 0, 0, isTouch and 32 or 28),
                    BackgroundColor3 = isSelected and (window.CurrentAccentDark or Theme.ElementActive) or Theme.Element,
                    BorderSizePixel = 0, Text = "", AutoButtonColor = false,
                    LayoutOrder = i, ZIndex = 5,
                }, { Corner(5) })
                item.Parent = listScroll

                Create("ImageLabel", {
                    Size = UDim2.new(0, 14, 0, 14), Position = UDim2.new(0, 8, 0.5, -7),
                    BackgroundTransparency = 1, Image = ICONS.DOT,
                    ImageColor3 = isSelected and (window.CurrentAccentColor or Theme.Accent) or Theme.TextMuted, ZIndex = 6,
                }).Parent = item

                Create("TextLabel", {
                    Size = UDim2.new(1, -40, 1, 0), Position = UDim2.new(0, 28, 0, 0),
                    BackgroundTransparency = 1, Text = opt,
                    TextColor3 = isSelected and Theme.Text or Theme.TextDim,
                    Font = isSelected and Enum.Font.GothamBold or Enum.Font.Gotham,
                    TextSize = 10, TextTruncate = Enum.TextTruncate.AtEnd,
                    TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 6,
                }).Parent = item

                item.MouseEnter:Connect(function()
                    if opt ~= selected then Tween(item, 0.12, { BackgroundColor3 = Theme.ElementHover }) end
                end)
                item.MouseLeave:Connect(function()
                    if opt ~= selected then Tween(item, 0.12, { BackgroundColor3 = Theme.Element }) end
                end)
                item.MouseButton1Click:Connect(function()
                    selected = opt; btnText.Text = opt
                    rebuildList(); closeList()
                    if callback then task.spawn(callback, opt) end
                end)

                table.insert(optionButtons, item)
            end
        end

        openList = function()
            if isOpen then return end
            isOpen = true; rebuildList()
            mainBtn.BackgroundColor3 = Theme.BackgroundAlt
            iconLabel.Visible = false; closeIcon.Visible = true
            setStatus(Status.ON)
            task.defer(function()
                task.wait(0.03)
                local wanted = getWantedListHeight()
                listHolder.Size = UDim2.new(1, -12, 0, 0)
                TweenService:Create(listHolder, TweenInfo.new(0.32, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                    Size = UDim2.new(1, -12, 0, wanted)
                }):Play()
                TweenService:Create(frame, TweenInfo.new(0.32, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                    Size = UDim2.new(1, 0, 0, BASE_HEIGHT + wanted + 6)
                }):Play()
                for i, item in ipairs(optionButtons) do
                    item.BackgroundTransparency = 1
                    task.delay(i * 0.02, function()
                        if item and item.Parent then
                            Tween(item, 0.15, { BackgroundTransparency = 0 })
                        end
                    end)
                end
            end)
        end

        closeList = function()
            if not isOpen then return end
            isOpen = false
            mainBtn.BackgroundColor3 = Theme.Panel
            iconLabel.Visible = true; closeIcon.Visible = false
            setStatus(Status.OFF)
            Tween(listHolder, 0.2, { Size = UDim2.new(1, -12, 0, 0) })
            Tween(frame, 0.2, { Size = UDim2.new(1, 0, 0, BASE_HEIGHT) })
        end

        mainBtn.MouseButton1Click:Connect(function()
            if isOpen then closeList() else openList() end
        end)

        UserInputService.InputBegan:Connect(function(input)
            if not isOpen then return end
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                local p = input.Position
                local fp = frame.AbsolutePosition; local fs = frame.AbsoluteSize
                local inside = p.X >= fp.X and p.X <= fp.X + fs.X and p.Y >= fp.Y and p.Y <= fp.Y + fs.Y
                if not inside then closeList() end
            end
        end)

        local el = NewElement("dropdowns", frame)
        el.SetTitle     = function(_, t) lbl.Text = t end
        el.SetFont      = function(_, f) lbl.Font = f end
        el.SetTextColor = function(_, c) lbl.TextColor3 = c end
        el.SetIcon      = function(_, id) iconLabel.Image = id end
        el.SetCloseIcon = function(_, id) closeIcon.Image = id end
        el.Set = function(_, v) selected = v; btnText.Text = v
            if callback then task.spawn(callback, v) end end
        el.Update = function(_, c)
            c = c or {}
            if c.Title then lbl.Text = c.Title end
            if c.Options then
                currentOptions = {}
                for i, v in ipairs(c.Options) do currentOptions[i] = v end
                local found = false
                for _, v in ipairs(currentOptions) do if v == selected then found = true break end end
                if not found then
                    selected = currentOptions[1] or "Select"
                    btnText.Text = selected
                end
            end
            if c.Selected then
                for _, v in ipairs(currentOptions) do
                    if v == c.Selected then selected = v; btnText.Text = v; break end
                end
            end
            if c.Open ~= nil then
                if c.Open and not isOpen then openList() end
                if (not c.Open) and isOpen then closeList() end
            end
            if isOpen then rebuildList() end
        end
        el.AddOption = function(_, opt)
            table.insert(currentOptions, opt)
            if isOpen then rebuildList() end
        end
        el.RemoveOption = function(_, opt)
            for i, v in ipairs(currentOptions) do
                if v == opt then table.remove(currentOptions, i) break end
            end
            if selected == opt then
                selected = currentOptions[1] or "Select"
                btnText.Text = selected
            end
            if isOpen then rebuildList() end
        end
        el.GetSelected = function(_) return selected end
        el.GetOptions = function(_) return currentOptions end
        el.Open = openList
        el.Close = closeList
        el.Icon = iconLabel
        el.CloseIcon = closeIcon
        el.RefreshColor = function()
            iconLabel.ImageColor3 = window.CurrentAccentColor or Theme.Accent
            closeIcon.ImageColor3 = window.CurrentAccentColor or Theme.Accent
            if isOpen then rebuildList() end
        end
        window:RegisterType("dropdowns", el)
        return el
    end

    function tab:CreateTextBox(cfg)
        cfg = cfg or {}
        local frame = Create("Frame", {
            Size = UDim2.new(1, 0, 0, isTouch and 44 or 40),
            BackgroundColor3 = Theme.Element, BorderSizePixel = 0, LayoutOrder = nextOrder(),
        }, { Corner(Theme.CornerRadius), Stroke(Theme.Stroke, 1) })
        frame.Parent = content

        local statusBar, setStatus = MakeStatusBar(frame, Status.OFF)
        local strokeObj = frame:FindFirstChildOfClass("UIStroke")

        local lbl = Create("TextLabel", {
            Size = UDim2.new(0, 85, 1, 0), Position = UDim2.new(0, 24, 0, 0),
            BackgroundTransparency = 1, Text = cfg.Title or "Text",
            TextColor3 = Theme.Text, Font = Theme.ElementFont, TextSize = 10,
            TextXAlignment = Enum.TextXAlignment.Left,
        })
        lbl.Parent = frame

        local box = Create("TextBox", {
            Size = UDim2.new(1, -120, 0, isTouch and 30 or 26),
            Position = UDim2.new(0, 110, 0.5, isTouch and -15 or -13),
            BackgroundColor3 = Theme.Panel, BorderSizePixel = 0,
            Text = cfg.Default or "", PlaceholderText = cfg.Placeholder or "Type here...",
            TextColor3 = Theme.Text, PlaceholderColor3 = Theme.TextMuted,
            Font = Enum.Font.Gotham, TextSize = 10, ClearTextOnFocus = false,
            TextXAlignment = Enum.TextXAlignment.Left,
        }, { Corner(6), Stroke(Theme.StrokeLight, 1) })
        box.Parent = frame
        Create("UIPadding", { PaddingLeft = UDim.new(0, 8) }).Parent = box
        local boxStroke = box:FindFirstChildOfClass("UIStroke")

        box.Focused:Connect(function()
            setStatus(Status.ON)
            Tween(box, 0.15, { BackgroundColor3 = Theme.BackgroundAlt })
            if boxStroke then Tween(boxStroke, 0.15, { Color = window.CurrentAccentColor or Theme.Accent }) end
            if strokeObj then Tween(strokeObj, 0.15, { Color = window.CurrentAccentColor or Theme.Accent }) end
        end)
        box.FocusLost:Connect(function(enter)
            setStatus((box.Text ~= "") and Status.ON or Status.OFF)
            Tween(box, 0.15, { BackgroundColor3 = Theme.Panel })
            if boxStroke then Tween(boxStroke, 0.15, { Color = Theme.StrokeLight }) end
            if strokeObj then Tween(strokeObj, 0.15, { Color = Theme.Stroke }) end
            if cfg.Callback then task.spawn(cfg.Callback, box.Text, enter) end
        end)

        local el = NewElement("textboxes", frame)
        el.SetTitle     = function(_, t) lbl.Text = t end
        el.SetFont      = function(_, f) lbl.Font = f end
        el.SetTextColor = function(_, c) lbl.TextColor3 = c end
        el.SetText      = function(_, t) box.Text = t end
        el.GetText      = function(_) return box.Text end
        el.TextBox      = box
        window:RegisterType("textboxes", el)
        return el
    end

    function tab:CreateKeybind(cfg)
        cfg = cfg or {}
        local currentKey = cfg.Default or "None"
        local listening = false

        local frame = Create("Frame", {
            Size = UDim2.new(1, 0, 0, isTouch and 44 or 40),
            BackgroundColor3 = Theme.Element, BorderSizePixel = 0, LayoutOrder = nextOrder(),
        }, { Corner(Theme.CornerRadius), Stroke(Theme.Stroke, 1) })
        frame.Parent = content

        local statusBar, setStatus = MakeStatusBar(frame, Status.OFF)

        local lbl = Create("TextLabel", {
            Size = UDim2.new(1, -110, 1, 0), Position = UDim2.new(0, 24, 0, 0),
            BackgroundTransparency = 1, Text = cfg.Title or "Keybind",
            TextColor3 = Theme.Text, Font = Theme.ElementFont, TextSize = 10,
            TextXAlignment = Enum.TextXAlignment.Left,
        })
        lbl.Parent = frame

        local btn = Create("TextButton", {
            Size = UDim2.new(0, 80, 0, isTouch and 28 or 24),
            Position = UDim2.new(1, -94, 0.5, isTouch and -14 or -12),
            BackgroundColor3 = Theme.BackgroundAlt, BorderSizePixel = 0,
            Text = currentKey, TextColor3 = window.CurrentAccentColor or Theme.Accent,
            Font = Enum.Font.GothamBold, TextSize = 10, AutoButtonColor = false,
        }, { Corner(6), Stroke(window.CurrentAccentDark or Theme.AccentDark, 1.5) })
        btn.Parent = frame

        btn.MouseButton1Click:Connect(function()
            if listening then return end
            listening = true
            btn.Text = "..."
            setStatus(Status.ACTIVE)
            Tween(btn, 0.15, { BackgroundColor3 = window.CurrentAccentDark or Theme.AccentDark, TextColor3 = Theme.Text })
            local conn
            conn = UserInputService.InputBegan:Connect(function(input, processed)
                if processed then return end
                if input.UserInputType == Enum.UserInputType.Keyboard then
                    currentKey = (input.KeyCode == Enum.KeyCode.Unknown) and "None" or input.KeyCode.Name
                elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
                    currentKey = "Mouse1"
                elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
                    currentKey = "Mouse2"
                elseif input.UserInputType == Enum.UserInputType.Touch then
                    currentKey = "Touch"
                end
                btn.Text = currentKey
                setStatus((currentKey ~= "None") and Status.ON or Status.OFF)
                Tween(btn, 0.15, { BackgroundColor3 = Theme.BackgroundAlt,
                    TextColor3 = window.CurrentAccentColor or Theme.Accent })
                listening = false
                conn:Disconnect()
                if cfg.Callback then task.spawn(cfg.Callback, currentKey) end
            end)
            task.delay(5, function()
                if listening then
                    listening = false
                    btn.Text = currentKey
                    setStatus((currentKey ~= "None") and Status.ON or Status.OFF)
                    Tween(btn, 0.15, { BackgroundColor3 = Theme.BackgroundAlt,
                        TextColor3 = window.CurrentAccentColor or Theme.Accent })
                    conn:Disconnect()
                end
            end)
        end)

        setStatus((currentKey ~= "None") and Status.ON or Status.OFF)

        local el = NewElement("keybinds", frame)
        el.SetTitle     = function(_, t) lbl.Text = t end
        el.SetFont      = function(_, f) lbl.Font = f end
        el.SetTextColor = function(_, c) lbl.TextColor3 = c end
        el.GetKey       = function(_) return currentKey end
        el.SetKey       = function(_, k) currentKey = k; btn.Text = k end
        window:RegisterType("keybinds", el)
        return el
    end

