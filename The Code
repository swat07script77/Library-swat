        persist()
        for _, el in ipairs(self.Registry.all) do
            if el.Frame and el.Frame.Parent then
                pcall(function()
                    local t = el:GetType()
                    if t == "buttons" or t == "toggles" or t == "textboxes"
                       or t == "keybinds" or t == "fontPickers"
                       or t == "themePresets" or t == "colorPickers" then
                        el.Frame.Size = UDim2.new(1, 0, 0, math.floor((isTouch and 44 or 40) * scale))
                    elseif t == "sliders" then
                        el.Frame.Size = UDim2.new(1, 0, 0, math.floor((isTouch and 56 or 50) * scale))
                    elseif t == "labels" then
                        el.Frame.Size = UDim2.new(1, 0, 0, math.floor(20 * scale))
                    end
                end)
            end
        end
    end

    -- ============================================================
    -- FONT SCALE SYSTEM
    -- ============================================================
    local fontScale = saveData["FontScale"] or 1.0
    self.FontScale = fontScale

    local function snapshotFonts()
        local function scan(obj)
            if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
                if obj:GetAttribute("BaseTextSize") == nil then
                    obj:SetAttribute("BaseTextSize", obj.TextSize)
                end
            end
            for _, c in ipairs(obj:GetChildren()) do scan(c) end
        end
        if main then scan(main) end
        if gui then scan(gui) end
        if overlayGui then scan(overlayGui) end
    end

    function self:SetFontScale(scale)
        scale = math.clamp(scale, 0.7, 1.5)
        fontScale = scale
        self.FontScale = scale
        saveData["FontScale"] = scale
        persist()
        snapshotFonts()
        local function applyFont(obj)
            if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
                local base = obj:GetAttribute("BaseTextSize")
                if base then
                    obj.TextSize = math.max(6, math.floor(base * scale + 0.5))
                end
            end
            for _, c in ipairs(obj:GetChildren()) do applyFont(c) end
        end
        if main then applyFont(main) end
        if gui then applyFont(gui) end
        if overlayGui then applyFont(overlayGui) end
    end

    -- ============================================================
    -- FONT FAMILY SYSTEM
    -- ============================================================
    local originalFontsMap = {}

    local function saveOriginalFonts()
        local function storeRecursive(obj)
            if (obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox")) then
                if not originalFontsMap[obj] then
                    originalFontsMap[obj] = obj.Font
                end
            end
            for _, child in pairs(obj:GetChildren()) do
                storeRecursive(child)
            end
        end
        if main then storeRecursive(main) end
        if gui then storeRecursive(gui) end
        if overlayGui then storeRecursive(overlayGui) end
    end

    local function applyFontToAll(fontEnum)
        saveOriginalFonts()
        local function applyFontRecursive(obj)
            if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
                pcall(function() obj.Font = fontEnum end)
            end
            for _, child in pairs(obj:GetChildren()) do
                applyFontRecursive(child)
            end
        end
        if main then applyFontRecursive(main) end
        if gui then applyFontRecursive(gui) end
        if overlayGui then applyFontRecursive(overlayGui) end

        self.SelectedFont = fontEnum.Name
        saveData["SelectedFont"] = fontEnum.Name
        persist()
    end

    local function restoreOriginalFonts()
        for obj, font in pairs(originalFontsMap) do
            if obj and obj.Parent then
                pcall(function() obj.Font = font end)
            end
        end
        self.SelectedFont = nil
        saveData["SelectedFont"] = nil
        persist()
    end

    if saveData["SelectedFont"] then
        self.SelectedFont = saveData["SelectedFont"]
    end

