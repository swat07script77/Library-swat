local Theme = {}
for k, v in pairs(DefaultTheme) do Theme[k] = v end
local DefaultThemeCopy = {}
for k, v in pairs(DefaultTheme) do DefaultThemeCopy[k] = v end

local Status = { OFF = "off", ACTIVE = "active", ON = "on" }
local function statusColor(s)
    if s == Status.ON then return Theme.Success end
    if s == Status.ACTIVE then return Theme.Warning end
    return Theme.Error
end

local function Create(class, props, children)
    local i = Instance.new(class)
    if props then for k, v in pairs(props) do i[k] = v end end
    if children then for _, c in ipairs(children) do c.Parent = i end end
    return i
end
local function Corner(r) return Create("UICorner", { CornerRadius = UDim.new(0, r or Theme.CornerRadius) }) end
local function Stroke(color, thickness)
    return Create("UIStroke", { Color = color or Theme.Stroke, Thickness = thickness or 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end
local function Gradient(c1, c2, rot)
    return Create("UIGradient", { Color = ColorSequence.new(c1, c2), Rotation = rot or 0 })
end
local function Tween(inst, t, props)
    TweenService:Create(inst, TweenInfo.new(t or 0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
end
local function GetViewport()
    local cam = workspace.CurrentCamera
    return cam and cam.ViewportSize or Vector2.new(1280, 720)
end
local function IsTouchDevice() return UserInputService.TouchEnabled end

-- ============================================================
-- GLOW EFFECT PARA BOTÕES (segue o mouse dentro do botão)
-- ============================================================
local function AddButtonGlow(button, accentColor)
    local glow = Instance.new("Frame")
    glow.Name = "SwatGlow"
    glow.Size = UDim2.new(0, 60, 0, 60)
    glow.AnchorPoint = Vector2.new(0.5, 0.5)
    glow.BackgroundColor3 = accentColor or Color3.new(1, 1, 1)
    glow.BackgroundTransparency = 1
    glow.BorderSizePixel = 0
    glow.ZIndex = 50
    local glowCorner = Instance.new("UICorner")
    glowCorner.CornerRadius = UDim.new(1, 0)
    glowCorner.Parent = glow
    glow.Parent = button

    local active = false
    local conn

    local function updateGlow(x, y)
        if not active then return end
        local absPos = button.AbsolutePosition
        local absSize = button.AbsoluteSize
        local lx = x - absPos.X
        local ly = y - absPos.Y
        lx = math.clamp(lx, 0, absSize.X)
        ly = math.clamp(ly, 0, absSize.Y)
        glow.Position = UDim2.new(0, lx, 0, ly)
    end

    local function showGlow(x, y)
        if active then return end
        active = true
        glow.BackgroundColor3 = accentColor or Color3.new(1, 1, 1)
        updateGlow(x, y)
        Tween(glow, 0.15, { BackgroundTransparency = 0.75, Size = UDim2.new(0, 90, 0, 90) })
        conn = UserInputService.InputChanged:Connect(function(input)
            if not active then return end
            if input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch then
                updateGlow(input.Position.X, input.Position.Y)
            end
        end)
    end

    local function hideGlow()
        if not active then return end
        active = false
        if conn then conn:Disconnect(); conn = nil end
        Tween(glow, 0.2, { BackgroundTransparency = 1, Size = UDim2.new(0, 60, 0, 60) })
    end

    button.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            showGlow(input.Position.X, input.Position.Y)
        end
    end)
    button.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            hideGlow()
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            hideGlow()
        end
    end)
    return glow
end

local function MakeDraggable(frame)
    local dragging, dragStart, startPos
    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true; dragStart = input.Position; startPos = frame.Position
        end
    end)
    frame.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            local d = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X,
                                       startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end)
end

local function MakeStatusBar(parent, init)
    local bar = Create("Frame", {
        Size = UDim2.new(0, 5, 0, 20), Position = UDim2.new(0, 10, 0.5, -10),
        BackgroundColor3 = statusColor(init or Status.OFF), BorderSizePixel = 0, ZIndex = 2,
    }, { Corner(2) })
    bar.Parent = parent
    local function set(s) Tween(bar, 0.2, { BackgroundColor3 = statusColor(s) }) end
    return bar, set
end

local function NewElement(type, baseFrame)
    local el = { Type = type, Frame = baseFrame, _enabled = true }
    el.SetVisible    = function(_, v) baseFrame.Visible = v end
    el.SetSize       = function(_, s) baseFrame.Size = s end
    el.SetPosition   = function(_, p) baseFrame.Position = p end
    el.SetBackground = function(_, c) baseFrame.BackgroundColor3 = c end
    el.SetColor      = el.SetBackground
    el.GetFrame      = function(_) return baseFrame end
    el.GetType       = function(_) return type end
    el.Destroy       = function(_) baseFrame:Destroy() end
    el.SetTitle      = function() end
    el.SetFont       = function() end
    el.SetTextColor  = function() end
    el.SetStroke     = function(_, c, t)
        local s = baseFrame:FindFirstChildOfClass("UIStroke")
        if s then if c then s.Color = c end if t then s.Thickness = t end end
    end
    el.SetCorner = function(_, r)
        local c = baseFrame:FindFirstChildOfClass("UICorner")
        if c then c.CornerRadius = UDim.new(0, r) end
    end
    el.SetTransparency = function(_, t) baseFrame.BackgroundTransparency = math.clamp(t, 0, 1) end
    el.SetEnabled = function(_, v)
        el._enabled = v; baseFrame.Active = v
        baseFrame.BackgroundTransparency = v and 0 or 0.4
    end
    el.IsEnabled = function(_) return el._enabled end
    el.Pulse = function(_, n, d)
        n = n or 3; d = d or 0.15
        task.spawn(function()
            for i = 1, n do
                baseFrame.BackgroundTransparency = 0.4; task.wait(d)
                baseFrame.BackgroundTransparency = 0; task.wait(d)
            end
        end)
    end
    el.FlashColor = function(_, color, back, dur)
        back = back or baseFrame.BackgroundColor3; dur = dur or 0.3
        Tween(baseFrame, dur, { BackgroundColor3 = color })
        task.delay(dur * 2, function() Tween(baseFrame, dur, { BackgroundColor3 = back }) end)
    end
    el.AnimateColor = function(_, color, dur) Tween(baseFrame, dur or 0.3, { BackgroundColor3 = color }) end
    return el
end

