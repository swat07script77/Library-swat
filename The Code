            Size = UDim2.new(1, -100, 0, 16), Position = UDim2.new(0, 24, 0, 6),
            BackgroundTransparency = 1, Text = cfg.Title or "Slider",
            TextColor3 = Theme.Text, Font = Theme.ElementFont, TextSize = 10,
            TextXAlignment = Enum.TextXAlignment.Left,
        })
        lbl.Parent = frame

        local valBox = Create("Frame", {
            Size = UDim2.new(0, 56, 0, 22), Position = UDim2.new(1, -68, 0, 5),
            BackgroundColor3 = Theme.Panel, BorderSizePixel = 0, ZIndex = 5,
        }, { Corner(4), Stroke(Theme.StrokeLight, 1) })
        valBox.Parent = frame

        local valBtn = Create("TextButton", { Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 6 })
        valBtn.Parent = valBox

        local valText = Create("TextLabel", {
            Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
            Text = tostring(value), TextColor3 = Theme.Accent,
            Font = Enum.Font.GothamBold, TextSize = 10, ZIndex = 7,
        })
        valText.Parent = valBox

        local editBox = Create("TextBox", {
            Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = Theme.BackgroundAlt,
            BorderSizePixel = 0, Text = tostring(value), TextColor3 = Theme.Accent,
            Font = Enum.Font.GothamBold, TextSize = 10, ClearTextOnFocus = false,
            Visible = false, ZIndex = 8, TextXAlignment = Enum.TextXAlignment.Center,
        }, { Corner(4), Stroke(Theme.Accent, 1.5) })
        editBox.Parent = valBox

        local barY = isTouch and 38 or 34
        local bar = Create("Frame", {
            Size = UDim2.new(1, -24, 0, 5), Position = UDim2.new(0, 12, 0, barY),
            BackgroundColor3 = Theme.BackgroundAlt, BorderSizePixel = 0,
        }, { Corner(99), Stroke(Theme.Stroke, 1) })
        bar.Parent = frame

        local fill = Create("Frame", {
            Size = UDim2.new((value - min) / (max - min), 0, 1, 0),
            BackgroundColor3 = Theme.Accent, BorderSizePixel = 0,
        }, { Corner(99), Gradient(Theme.AccentDark, Theme.Accent, 0) })
        fill.Parent = bar

        local knobSize = isTouch and 16 or 12
        local knob = Create("Frame", {
            Size = UDim2.new(0, knobSize, 0, knobSize),
            Position = UDim2.new((value - min) / (max - min), -knobSize/2, 0.5, -knobSize/2),
            BackgroundColor3 = Color3.new(1,1,1), BorderSizePixel = 0, ZIndex = 2,
        }, { Corner(99), Stroke(Theme.Accent, 2) })
        knob.Parent = bar
        local knobStroke = knob:FindFirstChildOfClass("UIStroke")

        local click = Create("TextButton", {
            Size = UDim2.new(1, 0, 0, isTouch and 26 or 22),
            Position = UDim2.new(0, 0, 0, barY - 6),
            BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 4,
        })
        click.Parent = frame

        local dragging = false
        local function applyValue(v, cb)
            v = math.clamp(math.floor(v), min, max)
            value = v
            local rel = (value - min) / (max - min)
            fill.Size = UDim2.new(rel, 0, 1, 0)
            knob.Position = UDim2.new(rel, -knobSize/2, 0.5, -knobSize/2)
            valText.Text = tostring(value)
            setStatus((value > min) and Status.ON or Status.OFF)
            if cb and cfg.Callback then task.spawn(cfg.Callback, value) end
        end

        local function fromX(x)
            local rel = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
            applyValue(min + (max - min) * rel, true)
        end

        click.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true; fromX(input.Position.X)
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch) then
                fromX(input.Position.X)
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
        end)

        valBtn.MouseButton1Click:Connect(function()
            valText.Visible = false
            editBox.Visible = true
            editBox.Text = tostring(value)
            task.wait(0.05)
            editBox:CaptureFocus()
        end)

        editBox:GetPropertyChangedSignal("Text"):Connect(function()
            local cleaned = editBox.Text:gsub("[^%d%-]", "")
            if cleaned:sub(1,1) == "-" then
                cleaned = "-" .. cleaned:sub(2):gsub("%-", "")
            else
                cleaned = cleaned:gsub("%-", "")
            end
            if cleaned ~= editBox.Text then editBox.Text = cleaned end
        end)

        editBox.FocusLost:Connect(function()
            local num = tonumber(editBox.Text) or value
            applyValue(num, true)
            editBox.Visible = false
            valText.Visible = true
        end)

        setStatus((value > min) and Status.ON or Status.OFF)

        window:RegisterThemeListener(function()
            Tween(frame, 0.2, { BackgroundColor3 = Theme.Element })
            Tween(bar, 0.2, { BackgroundColor3 = Theme.BackgroundAlt })
            local c = window.CurrentAccentColor or Theme.Accent
            local cd = window.CurrentAccentDark or Theme.AccentDark
            fill.BackgroundColor3 = c
            local grad = fill:FindFirstChildOfClass("UIGradient")
            if grad then grad.Color = ColorSequence.new(cd, c) end
            if knobStroke then knobStroke.Color = c end
            valText.TextColor3 = c
        end)

        local el = NewElement("sliders", frame)
        el.SetValue     = function(_, v) applyValue(v, true) end
        el.GetValue     = function(_) return value end
        el.SetTitle     = function(_, t) lbl.Text = t end
        el.SetFont      = function(_, f) lbl.Font = f end
        el.SetTextColor = function(_, c) lbl.TextColor3 = c end
        el.SetBarY      = function(_, y) bar.Position = UDim2.new(0, 12, 0, y) end
        el.RefreshColor = function()
            local c = window.CurrentAccentColor or Theme.Accent
            local cd = window.CurrentAccentDark or Theme.AccentDark
            fill.BackgroundColor3 = c
            local grad = fill:FindFirstChildOfClass("UIGradient")
            if grad then grad.Color = ColorSequence.new(cd, c) end
            if knobStroke then knobStroke.Color = c end
            valText.TextColor3 = c
        end
        window:RegisterType("sliders", el)
        return el
    end

    function tab:CreateColorPicker(cfg)
        cfg = cfg or {}
        local title = cfg.Title or "Color"
        local defaultColor = cfg.Default or Color3.fromRGB(255, 50, 50)
        local callback = cfg.Callback
        local themeKey = cfg.ThemeKey

        local BASE_HEIGHT = isTouch and 44 or 40
        local MAX_HEIGHT = BASE_HEIGHT * 4

        local frame = Create("Frame", {
