        holder.Parent = content

        local marker = Create("Frame", {
            Size = UDim2.new(0, 3, 0.7, 0), Position = UDim2.new(0, 0, 0.15, 0),
            BackgroundColor3 = Theme.AccentDark, BorderSizePixel = 0,
        }, { Corner(2) })
        marker.Parent = holder

        local lbl = Create("TextLabel", {
            Size = UDim2.new(1, -12, 1, 0), Position = UDim2.new(0, 12, 0, 0),
            BackgroundTransparency = 1, Text = text,
            TextColor3 = Theme.TextDim, Font = Enum.Font.Gotham, TextSize = 10,
            TextXAlignment = Enum.TextXAlignment.Left,
        })
        lbl.Parent = holder

        window:RegisterThemeListener(function()
            marker.BackgroundColor3 = window.CurrentAccentDark or Theme.AccentDark
        end)

        local el = NewElement("labels", holder)
        el.SetTitle     = function(_, t) lbl.Text = t end
        el.SetFont      = function(_, f) lbl.Font = f end
        el.SetTextColor = function(_, c) lbl.TextColor3 = c end
        window:RegisterType("labels", el)
        return el
    end

    function tab:CreateToggle(cfg)
        cfg = cfg or {}
        local toggled = cfg.Default or false

        local frame = Create("Frame", {
            Size = UDim2.new(1, 0, 0, isTouch and 44 or 40),
            BackgroundColor3 = Theme.Element, BorderSizePixel = 0,
            LayoutOrder = nextOrder(), ClipsDescendants = true,
        }, { Corner(Theme.CornerRadius), Stroke(Theme.Stroke, 1) })
        frame.Parent = content

        local statusBar, setStatus = MakeStatusBar(frame, toggled and Status.ON or Status.OFF)

        local lbl = Create("TextLabel", {
            Size = UDim2.new(1, -80, 1, 0), Position = UDim2.new(0, 24, 0, 0),
            BackgroundTransparency = 1, Text = cfg.Title or "Toggle",
            TextColor3 = Theme.Text, Font = Theme.ElementFont, TextSize = 11,
            TextXAlignment = Enum.TextXAlignment.Left,
        })
        lbl.Parent = frame

        local bg = Create("Frame", {
            Size = UDim2.new(0, 48, 0, 22), Position = UDim2.new(1, -60, 0.5, -11),
            BackgroundColor3 = toggled and (window.CurrentAccentColor or Theme.Accent) or Theme.ElementHover,
            BorderSizePixel = 0,
        }, { Corner(99) })
        bg.Parent = frame

        local bgStroke = Stroke(toggled and (window.CurrentAccentDark or Theme.AccentDark) or Theme.StrokeLight, 1)
        bgStroke.Parent = bg

        local circle = Create("Frame", {
            Size = UDim2.new(0, 18, 0, 18),
            Position = toggled and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 2, 0.5, -9),
            BackgroundColor3 = Color3.new(1,1,1), BorderSizePixel = 0, ZIndex = 2,
        }, { Corner(99) })
        circle.Parent = bg

        local btn = Create("TextButton", { Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1, Text = "" })
        btn.Parent = frame

        local function render()
            local spd = window.ToggleSpeed or 0.2
            local col = window.CurrentAccentColor or Theme.Accent
            local dark = window.CurrentAccentDark or Theme.AccentDark
            Tween(bg, spd, { BackgroundColor3 = toggled and col or Theme.ElementHover })
            Tween(bgStroke, spd, { Color = toggled and dark or Theme.StrokeLight })
            Tween(circle, spd, {
                Position = toggled and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 2, 0.5, -9)
            })
            setStatus(toggled and Status.ON or Status.OFF)
        end

        btn.MouseButton1Click:Connect(function()
            toggled = not toggled
            render()
            if cfg.Callback then task.spawn(cfg.Callback, toggled) end
        end)

        window:RegisterThemeListener(function()
            Tween(frame, 0.2, { BackgroundColor3 = Theme.Element })
            Tween(lbl, 0.2, { TextColor3 = Theme.Text })
            render()
        end)

        local el = NewElement("toggles", frame)
        el.SetTitle     = function(_, t) lbl.Text = t end
        el.SetFont      = function(_, f) lbl.Font = f end
        el.SetTextColor = function(_, c) lbl.TextColor3 = c end
        el.SetValue     = function(_, v) toggled = v; render() end
        el.GetValue     = function(_) return toggled end
        el.Render       = render
        window:RegisterType("toggles", el)
        return el
    end

    -- ============================================================
    -- SLIDER (sem efeito de corte/transparência)
    -- ============================================================
