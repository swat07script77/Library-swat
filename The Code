    local function panelSlider(title, min, max, default, onChange, step)
        step = step or 1
        local row = Create("Frame", {
            Size = UDim2.new(1, 0, 0, 38),
            BackgroundColor3 = Theme.Element, BorderSizePixel = 0,
            LayoutOrder = nextSO(),
        }, { Corner(6), Stroke(Theme.Stroke, 1) })
        row.Parent = settingsScroll
        local val = math.clamp(default, min, max)
        Create("TextLabel", {
            Size = UDim2.new(1, -60, 0, 14), Position = UDim2.new(0, 8, 0, 3),
            BackgroundTransparency = 1, Text = title,
            TextColor3 = Theme.Text, Font = Enum.Font.Gotham, TextSize = 9,
            TextXAlignment = Enum.TextXAlignment.Left,
        }).Parent = row
        local valLbl = Create("TextLabel", {
            Size = UDim2.new(0, 55, 0, 14), Position = UDim2.new(1, -62, 0, 3),
            BackgroundTransparency = 1, Text = (step < 1) and string.format("%.2f", val) or tostring(math.floor(val + 0.5)),
            TextColor3 = Theme.Accent, Font = Enum.Font.GothamBold, TextSize = 9,
            TextXAlignment = Enum.TextXAlignment.Right,
        })
        valLbl.Parent = row
        local bar = Create("Frame", {
            Size = UDim2.new(1, -16, 0, 4), Position = UDim2.new(0, 8, 0, 24),
            BackgroundColor3 = Theme.BackgroundAlt, BorderSizePixel = 0,
        }, { Corner(99) })
        bar.Parent = row
        local fill = Create("Frame", {
            Size = UDim2.new((val - min) / (max - min), 0, 1, 0),
            BackgroundColor3 = Theme.Accent, BorderSizePixel = 0,
        }, { Corner(99) })
        fill.Parent = bar
        local knob = Create("Frame", {
            Size = UDim2.new(0, 10, 0, 10),
            Position = UDim2.new((val - min) / (max - min), -5, 0.5, -5),
            BackgroundColor3 = Color3.new(1,1,1), BorderSizePixel = 0, ZIndex = 2,
        }, { Corner(99), Stroke(Theme.Accent, 1.5) })
        knob.Parent = bar
        local click = Create("TextButton", {
            Size = UDim2.new(1, 0, 0, 18), Position = UDim2.new(0, 0, 0, 18),
            BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 3,
        })
        click.Parent = row
        local dragging = false
        local function apply(v, cb)
            v = math.clamp(v, min, max)
            v = math.floor(v / step + 0.5) * step
            local rel = (v - min) / (max - min)
            fill.Size = UDim2.new(rel, 0, 1, 0)
            knob.Position = UDim2.new(rel, -5, 0.5, -5)
            valLbl.Text = (step < 1) and string.format("%.2f", v) or tostring(math.floor(v + 0.5))
            if cb and onChange then task.spawn(onChange, v) end
        end
        local function fromX(x)
            local rel = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
            apply(min + (max - min) * rel, true)
        end
        click.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true; fromX(input.Position.X)
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch) then
                fromX(input.Position.X)
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
        end)
        local api = { SetValue = function(v) apply(v, false) end, GetValue = function() return val end }
        table.insert(panelRefs, { api = api, default = default })
        return api
    end

